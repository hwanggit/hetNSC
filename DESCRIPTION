Package: hetNSC
Type: Package
Title: Heteroscedastic Nearest Shrunken Centroid Classification
Version: 0.1.0
Authors@R: c(
    person("Haiyan", "Wang", email = "hwang@ksu.edu", role = c("aut", "cre")),
